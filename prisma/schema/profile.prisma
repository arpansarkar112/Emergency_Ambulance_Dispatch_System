model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  firstName        String?
  lastName         String?
  phone            String?
  address          String?
  avatarUrl        String?
  emergencyContact String?
  bloodGroup       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
